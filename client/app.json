{
  "expo": {
    "name": "pc-controll-client",
    "slug": "pc-controll-client",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2b6cf0"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Discover and connect to PCs on your local network.",
        "NSBonjourServices": [
          "_remotepad._tcp",
          "_remotepad._tcp"
        ]
      },
      "bundleIdentifier": "com.aksandr.pccontrollclient"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2b6cf0"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.NEARBY_WIFI_DEVICES"
      ],
      "package": "com.aksandr.pccontrollclient"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "./plugins/withAbiFilters",
        {
          "abis": [
            "arm64-v8a"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "db12a56e-3e01-40e1-9600-f54cb2a02936"
      }
    },
    "icon": "./assets/icon.png"
  }
}
